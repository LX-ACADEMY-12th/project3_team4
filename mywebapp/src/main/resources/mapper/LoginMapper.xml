<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.team4.mywebapp.mapper.LoginMapper">

	<!-- 로그인 -->
	<select id="authenticateUser" resultType="com.team4.mywebapp.dto.LoginDto">
		SELECT 
			login_id, 
			login_pw
		FROM 
			user
		WHERE 
			login_id = #{loginId} AND login_pw = #{loginPw}
	</select>

</mapper>
	