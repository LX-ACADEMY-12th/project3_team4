<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.team4.mywebapp.mapper.UserMapper">

	<update id="updateUserInfo" parameterType="com.team4.mywebapp.dto.UserUpdateDto">
	    UPDATE user
	    SET
	        <trim suffixOverrides=",">
	            <if test="profilePhotoPath != null">profile_photo_path = #{profilePhotoPath},</if>
	            <if test="statusMessage != null">status_message = #{statusMessage},</if>
	            <if test="todayMood != null">today_mood = #{todayMood},</if>
	            <if test="birthDate != null">birth_date = #{birthDate},</if>
	            <if test="gender != null">gender = #{gender},</if>
	            <if test="region != null">region = #{region},</if>
	            <if test="hobby != null">hobby = #{hobby},</if>
	        </trim>
	    WHERE user_id = #{userId}
	</update>

</mapper>