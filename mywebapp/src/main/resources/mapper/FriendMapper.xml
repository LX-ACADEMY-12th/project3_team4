<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.team4.mywebapp.mapper.FriendMapper">

	<!-- 전체 사용자 리스트 쿼리 -->
	<select id="getAllUsers" parameterType="String" resultType="com.team4.mywebapp.dto.FriendDto">
		SELECT
			user_id AS userId,
			login_id AS loginId,
			nickname AS nickname
		FROM user
		WHERE login_id &lt;&gt; #{loginId}
	</select>
	
</mapper>